PROOFCLOSE_ENV=demo
PROOFCLOSE_DATA_DIR=.runtime
PROOFCLOSE_DEMO_TENANT_ID=demo_merchant
PROOFCLOSE_DEMO_ACTOR_ID=demo_operator
PROOFCLOSE_BANK_PENDING_HOURS=3
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
# Process-local attempt allowance per tenant/run (retries also consume it).
# Set 0 for deterministic-only responses. This is not production rate limiting.
PROOFCLOSE_PROVIDER_CALL_BUDGET=20
